# Environment for a local (laptop) run of the portal.
#
# Copy to .env, fill in, and load it before starting — Backstage does not read
# .env by itself, so the shell has to export the values:
#
#   set -a; source .env; set +a
#   yarn start
#
# .env is gitignored. Nothing secret belongs in this file.

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------

# Used by the catalog to read catalog-info.yaml files, and by the scaffolder to
# create repositories. In a local run the simplest source is the CLI's own
# token, which already carries repo + workflow scope:
#
#   export GITHUB_TOKEN="$(gh auth token)"
GITHUB_TOKEN=

# The GitHub OAuth app that signs developers in. Create it at
# https://github.com/settings/developers with:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame
#
# Until these exist the portal still boots — app-config.yaml keeps the guest
# provider enabled for exactly that reason — but every catalog entity is owned
# by a user nobody is signed in as.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# The numeric App ID of the platform-deploy-bot GitHub App. Not a secret.
PLATFORM_DEPLOY_BOT_APP_ID=4837613

# ---------------------------------------------------------------------------
# Cluster
# ---------------------------------------------------------------------------

AWS_REGION=us-east-1

# The EKS API endpoint. `authProvider: aws` in app-config means the backend
# signs requests with whatever AWS credentials the process already has.
K8S_CLUSTER_URL=https://56D5B6A78161974E904D50A4DE66E927.gr7.us-east-1.eks.amazonaws.com

# The AI Platform Agent's NetworkPolicy admits ingress only from inside the
# cluster, so a laptop-run portal reaches it only through a port-forward:
#
#   kubectl port-forward svc/ai-platform-agent -n ai-platform 7008:80
#
# In-cluster this is http://ai-platform-agent.ai-platform.svc.cluster.local
AI_PLATFORM_AGENT_URL=http://localhost:7008

# ArgoCD, port-forwarded:
#
#   kubectl port-forward svc/argocd-server -n argocd 8443:443
#
# Note that argocd-server presents a self-signed certificate issued for its
# in-cluster name, not for localhost. The backend will reject it. This is a
# real limitation of running the portal off-cluster, not a configuration
# mistake to work around by disabling TLS verification.
ARGOCD_URL=https://localhost:8443

# Issued against the dedicated read-only `backstage` account — see
# bootstrap/argocd-values.yaml in platform-demo-gitops. Not the admin password.
ARGOCD_AUTH_TOKEN=

# Grafana, port-forwarded:
#
#   kubectl port-forward svc/kube-prometheus-stack-grafana -n monitoring 3001:80
GRAFANA_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Production only — read by app-config.production.yaml, unused in a local run
# ---------------------------------------------------------------------------

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
TECHDOCS_S3_BUCKET=
